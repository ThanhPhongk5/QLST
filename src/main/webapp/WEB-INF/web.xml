<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>QLST – Quản Lý Siêu Thị</display-name>
    <description>
        Hệ thống Quản lý Siêu thị – Phân tích Thiết kế Hệ thống (Kiến trúc 3 tầng: JSP - DAO - Entity).
        MSSV: 10B23DCCN646
    </description>

    <!-- Welcome page -->
    <welcome-file-list>
        <welcome-file>HomePage.jsp</welcome-file>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Error pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/error404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error500.jsp</location>
    </error-page>

    <!-- Ép mã hóa chuẩn UTF-8 toàn hệ thống JSP -->
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <page-encoding>UTF-8</page-encoding>
            <trim-directive-whitespaces>true</trim-directive-whitespaces>
            <default-content-type>text/html; charset=UTF-8</default-content-type>
        </jsp-property-group>
    </jsp-config>

</web-app>
